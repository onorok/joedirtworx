<%- include('partials/header', { title: 'Our Work | Joe Dirt Worx' }) %>

<section class="page-hero">
  <div class="wrap">
    <p class="eyebrow">Joe Dirt Worx</p>
    <h1>Our Work</h1>
    <p>Land clearing, ponds, driveways, and site prep across the River Valley.</p>
    <p class="admin-entry">
      <a href="<%= isAdmin ? '/admin/projects' : '/admin' %>"><%= isAdmin ? 'Manage projects' : 'Admin login' %></a>
    </p>
  </div>
</section>

<section class="work-page">
  <div class="wrap">
    <% if (projects.length) { %>
      <% projects.forEach((project) => { %>
        <article class="work-project" id="<%= project.id %>">
          <div class="work-copy">
            <h2><%= project.title %></h2>
            <% if (project.description) { %>
              <p><%= project.description %></p>
            <% } %>
          </div>
          <div class="project-grid">
            <% project.images.forEach((image, index) => { %>
              <button
                type="button"
                class="project-card lightbox-trigger"
                data-project="<%= project.id %>"
                data-index="<%= index %>"
                data-src="<%= image.url %>"
                data-title="<%= project.title %>"
              >
                <img src="<%= image.url %>" alt="<%= project.title %>">
                <span><%= project.title %></span>
              </button>
            <% }) %>
          </div>
        </article>
      <% }) %>
    <% } else { %>
      <p class="empty">No projects uploaded yet. Check back soon or call <%= phone %>.</p>
    <% } %>
  </div>
</section>

<dialog class="lightbox" id="lightbox" aria-label="Project photo">
  <button class="lightbox-close" type="button" aria-label="Close">&times;</button>
  <button class="lightbox-prev" type="button" aria-label="Previous photo">
    <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
  </button>
  <figure class="lightbox-stage">
    <img alt="">
    <figcaption></figcaption>
  </figure>
  <button class="lightbox-next" type="button" aria-label="Next photo">
    <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
  </button>
</dialog>

<%- include('partials/footer') %>
