<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title === 'string' ? title : 'Joe Dirt Worx | Land Clearing & Dirt Work' %></title>
  <meta name="description" content="Dependable land clearing and dirt work in Russellville, Harrison, Clarksville, and surrounding Arkansas areas.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/">
        <img src="/img/logo-mark.png" alt="" width="56" height="48">
        <span>
          <strong>JOE DIRT WORX</strong>
          <em>Land Clearing & Dirt Work</em>
        </span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
      <nav id="site-nav" class="site-nav">
        <a href="/" class="<%= currentPath === '/' ? 'is-active' : '' %>">Home</a>
        <a href="/#services">Services</a>
        <a href="/work" class="<%= currentPath === '/work' ? 'is-active' : '' %>">Our Work</a>
        <a href="/#about">About Us</a>
        <a href="/#service-area">Service Area</a>
        <a href="/#contact">Contact</a>
      </nav>
      <a class="btn btn-orange header-phone" href="<%= phoneHref %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1.2 1.2 0 0 1 1.2-.3 13 13 0 0 0 4.1.7 1.2 1.2 0 0 1 1.2 1.2V20a1.2 1.2 0 0 1-1.2 1.2A17.2 17.2 0 0 1 2.8 4.2 1.2 1.2 0 0 1 4 3h3.2A1.2 1.2 0 0 1 8.4 4.2a13 13 0 0 0 .7 4.1 1.2 1.2 0 0 1-.3 1.2z"/></svg>
        <%= phone %>
      </a>
    </div>
  </header>
