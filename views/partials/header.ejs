<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="/favicon.ico?v=2" sizes="any">
  <link rel="icon" type="image/png" href="/favicon-32.png?v=2" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">
  <title><%= typeof title === 'string' ? title : 'Joe Dirt Worx | Land Clearing & Dirt Work' %></title>
  <meta name="description" content="Dependable land clearing and dirt work in Russellville, Harrison, Clarksville, and surrounding Arkansas areas.">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Joe Dirt Worx">
  <meta property="og:title" content="<%= typeof title === 'string' ? title : 'Joe Dirt Worx | Land Clearing & Dirt Work' %>">
  <meta property="og:description" content="Dependable land clearing and dirt work in Russellville, Harrison, Clarksville, and surrounding Arkansas areas.">
  <meta property="og:url" content="<%= siteUrl %><%= currentPath === '/' ? '' : currentPath %>">
  <meta property="og:image" content="<%= siteUrl %>/img/og.jpg">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Joe Dirt Worx — Dirt Work Done Right.">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= typeof title === 'string' ? title : 'Joe Dirt Worx | Land Clearing & Dirt Work' %>">
  <meta name="twitter:description" content="Dependable land clearing and dirt work in Russellville, Harrison, Clarksville, and surrounding Arkansas areas.">
  <meta name="twitter:image" content="<%= siteUrl %>/img/og.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
  <link rel="stylesheet" href="/css/style.css?v=4">
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/">
        <img class="brand-mark" src="/img/logo-mark.png?v=2" alt="Joe Dirt Worx" width="72" height="72">
        <span class="brand-text">
          <strong>Joe Dirt Worx</strong>
          <em>Land Clearing & Dirt Work</em>
        </span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      </button>
      <nav id="site-nav" class="site-nav">
        <a href="/" class="<%= currentPath === '/' ? 'is-active' : '' %>">Home</a>
        <a href="/#services">Services</a>
        <a href="/work" class="<%= currentPath === '/work' ? 'is-active' : '' %>">Our Work</a>
        <a href="/#about">About Us</a>
        <a href="/#service-area">Service Area</a>
        <a href="/#contact">Contact</a>
      </nav>
      <a class="btn btn-orange header-phone" href="<%= phoneHref %>">
        <i class="fa-solid fa-phone" aria-hidden="true"></i>
        <%= phone %>
      </a>
    </div>
  </header>
