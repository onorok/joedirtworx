<%- include('../partials/header', { title: 'Admin | Joe Dirt Worx' }) %>

<section class="admin-page admin-login-page">
  <form class="admin-card admin-login-card" method="post" action="/admin/login">
    <p class="eyebrow">Admin</p>
    <h1>Sign in</h1>
    <p>Upload project photos and details for the Our Work page.</p>
    <% if (error) { %>
      <p class="flash flash-error"><%= error %></p>
    <% } %>
    <div class="field">
      <label for="admin-password">Password</label>
      <input id="admin-password" type="password" name="password" autocomplete="current-password" required autofocus>
    </div>
    <button class="btn btn-orange" type="submit">Sign In</button>
  </form>
</section>

<%- include('../partials/footer') %>
