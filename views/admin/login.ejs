<%- include('../partials/header', { title: 'Admin | Joe Dirt Worx' }) %>

<section class="admin-page">
  <form class="admin-card" method="post" action="/admin/login">
    <p class="eyebrow">Admin</p>
    <h1>Sign in</h1>
    <p>This page is not linked from the public site. Use it to add project photos.</p>
    <% if (error) { %>
      <p class="flash flash-error"><%= error %></p>
    <% } %>
    <label>Password<input type="password" name="password" required autofocus></label>
    <button class="btn btn-orange" type="submit">Sign In</button>
  </form>
</section>

<%- include('../partials/footer') %>
